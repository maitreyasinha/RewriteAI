{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.go": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/download", "destination": "https://github.com/maitreyasinha/RewriteAI/releases/latest/download/<YOUR_APP>.dmg" }
  ]
}
